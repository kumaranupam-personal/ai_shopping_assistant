# Settings and secrets for docker-compose.yml (docs/13-deployment.md). Copy to .env on the server, which git
# ignores, and fill in the keys. Every variable is described in docs/01-architecture.md. For local development
# without Docker, the backend reads backend/.env instead (backend/.env.example).

# The model provider and its key (docs/09-llm-providers.md).
LLM_PROVIDER=gemini
LLM_GEMINI_API_KEY=
LLM_OPENAI_API_KEY=
LLM_ANTHROPIC_API_KEY=
LLM_MODEL=
LLM_EFFORT=low
LLM_MAX_TOKENS=4000
SESSION_TTL_MINUTES=60
MAX_TURNS_PER_SESSION=15

# Tracing (docs/10-observability.md); empty turns it off.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
TRACE_MESSAGE_TEXT=false

# Abuse protection (docs/11-abuse-protection.md, Production values). The server's nginx sets X-Real-IP to the
# visitor's address; keep it with Cloudflare too, where nginx takes that address from CF-Connecting-IP
# (docs/13-deployment.md, Adding Cloudflare).
CLIENT_IP_HEADER=X-Real-IP
RATE_LIMIT_SESSIONS_PER_HOUR=10
RATE_LIMIT_CHAT_PER_MINUTE=10
RATE_LIMIT_CHAT_PER_DAY=100
MAX_SESSIONS=1000
MAX_SESSIONS_PER_IP=20
MAX_CONCURRENT_TURNS=10
DAILY_BUDGET_USD=2
CHAT_ENABLED=true

# Cloudflare Turnstile: set both or neither. The site key is built into the frontend, so changing it needs a rebuild.
TURNSTILE_SECRET=
VITE_TURNSTILE_SITE_KEY=
